# Checkpoint-Rush safety limits.
# Keep destructive/benchmark data inside a disposable /tmp directory.

TEST_DATA_DIR="/tmp/checkpoint-rush-${USER:-labuser}"
MAX_TEST_DATA_GB=5
MAX_FILE_COUNT=50000
MAX_RUNTIME_SECONDS=120

# Benchmark scripts created later in the lab should read these values and abort
# rather than silently exceeding them.
